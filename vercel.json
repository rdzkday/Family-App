{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/(.*)sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(.*).webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    }
  ],
  "redirects": [
    { "source": "/dark/(.*)", "destination": "/", "permanent": false },
    { "source": "/beranda.html", "destination": "/", "permanent": false },
    { "source": "/kantong.html", "destination": "/kantong/", "permanent": false },
    { "source": "/komitmen.html", "destination": "/komitmen/", "permanent": false },
    { "source": "/ruang-catat", "destination": "/daily-mood/", "permanent": false },
    { "source": "/ruang-catat/:path*", "destination": "/daily-mood/:path*", "permanent": false }
  ]
}
